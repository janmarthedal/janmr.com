{% extends "page.njk" %}
{% block head -%}
{{ super() }}
<style>
#linkage-wrap {
  position: relative;
  margin: 1em 0;
}
#linkage {
  display: block;
  width: 100%;
  border: 1px solid #ddd;
  border-radius: 4px;
  touch-action: none;
}
#linkage-msg {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1em;
  text-align: center;
  color: #c9302c;
  pointer-events: none;
}
.pl-controls {
  display: grid;
  grid-template-columns: auto 1fr 3.5em;
  gap: 0.4em 0.8em;
  align-items: center;
  margin: 1em 0;
}
.pl-controls label {
  white-space: nowrap;
}
.pl-controls input[type=range] {
  width: 100%;
}
.pl-controls output {
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.pl-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5em 1.2em;
  align-items: center;
  margin: 1em 0;
}
.pl-btn {
  font-size: 1em;
  line-height: 1;
  padding: 0.4em 0.9em;
  background-color: #337ab7;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
